# macOS
.DS_Store

# Xcode user-specific
xcuserdata/
*.xcuserstate

# CocoaPods build artefacts (keep lockfile + Podfile; skip vendored sources)
Pods/
build/
DerivedData/

# Backups created during refactors
.backup/

# Cursor local state
.cursor/

# Serverless Lambda build + virtualenv artefacts
serverless/.venv/
serverless/.aws-sam/
serverless/package.zip
serverless/*.zip

# AWS credentials embedded in the app (never commit — GitHub secret scanning
# blocks pushes and AWS auto-disables leaked keys). Use the `.example` file
# as a template.
EgoCapture/Services/Upload/EmbeddedAWSSecrets.swift
