# macOS
.DS_Store

# Xcode user-specific
xcuserdata/
*.xcuserstate

# CocoaPods build artefacts (keep lockfile + Podfile; skip vendored sources)
Pods/
build/
DerivedData/

# Backups created during refactors
.backup/

# Cursor local state
.cursor/

# Local auth secrets
Config/Secrets.xcconfig

# Serverless Lambda build + virtualenv artefacts
serverless/.venv/
serverless/.aws-sam/
serverless/package.zip
serverless/*.zip

# AWS credentials embedded in the app (never commit — GitHub secret scanning
# blocks pushes and AWS auto-disables leaked keys). Use the `.example` file
# as a template.
EgoCapture/Services/Upload/EmbeddedAWSSecrets.swift
android/app/src/main/java/com/kgeneye/eye/upload/EmbeddedAwsSecrets.kt

# Android build artefacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
