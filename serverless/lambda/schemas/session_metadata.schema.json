{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionMetadata",
  "description": "Full session metadata from the iOS capture app (IMU-only mode). Mirrors SessionMetadata.swift.",
  "type": "object",
  "properties": {
    "sessionId":          { "type": "string" },
    "startTimeEpochMs":   { "type": "number" },
    "endTimeEpochMs":     { "type": "number" },
    "durationSec":        { "type": "number" },
    "environment":        { "type": "object" },
    "device":             { "type": "object" },
    "capture":            { "type": "object" },
    "camera":             { "type": "object" },
    "captureProfile":     { "type": "object" },
    "signalConfiguration":{ "type": "object" },
    "collector":          { "type": "object" },
    "videoEncoding":      { "type": "object" },
    "colorProfile":       { "type": "object" },
    "imuMetrics":         { "type": "object" },
    "videoMetrics":       { "type": "object" },
    "syncMetrics":        { "type": "object" },
    "captureHealth":      { "type": "object" },
    "cameraIntrinsics":   { "type": ["object", "null"] },
    "cameraExtrinsics":   { "type": ["object", "null"] },
    "specCompliance":     { "type": ["object", "null"] },
    "coordinateSystem":   { "type": "object" },
    "pipeline":           { "type": "object" },
    "validation":         { "type": "object" },
    "warnings":           { "type": "array", "items": { "type": "string" } }
  },
  "required": ["sessionId", "startTimeEpochMs", "endTimeEpochMs", "durationSec"],
  "additionalProperties": true
}
