{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IMUSample",
  "description": "Single synchronized accelerometer + gyroscope sample from CoreMotion (Apple device coordinate system).",
  "type": "object",
  "properties": {
    "timestampEpochMs": {
      "type": "number",
      "description": "Wall-clock epoch timestamp in milliseconds."
    },
    "relativeMs": {
      "type": "number",
      "description": "Milliseconds since the session recording started."
    },
    "timestampNs": {
      "type": "integer",
      "description": "Monotonic timestamp in nanoseconds (mach_absolute_time)."
    },
    "clock": {
      "type": "string",
      "description": "Clock source identifier. Expected: mach_absolute_time."
    },
    "accelerometer": {
      "type": "object",
      "description": "Acceleration in g (gravity included via CMDeviceMotion).",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "required": ["x", "y", "z"]
    },
    "gyroscope": {
      "type": "object",
      "description": "Angular velocity in radians per second.",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "required": ["x", "y", "z"]
    }
  },
  "required": ["timestampEpochMs", "timestampNs", "accelerometer", "gyroscope"],
  "additionalProperties": true
}
