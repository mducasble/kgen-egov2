{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CameraFormats",
  "description": "All available camera formats plus the selected one. Raw output of AVCaptureDevice.formats inspection.",
  "type": "object",
  "properties": {
    "deviceType":     { "type": "string" },
    "selectedFormat": { "type": "object" },
    "allFormats":     { "type": "array",  "items": { "type": "object" } }
  },
  "required": ["deviceType", "selectedFormat", "allFormats"],
  "additionalProperties": true
}
