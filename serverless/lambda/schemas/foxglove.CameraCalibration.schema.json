{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "foxglove.CameraCalibration",
  "description": "Camera intrinsic calibration following Foxglove standard. OpenCV convention.",
  "type": "object",
  "required": ["timestamp", "frame_id", "width", "height", "distortion_model", "D", "K"],
  "properties": {
    "timestamp": {
      "type": "object",
      "required": ["sec", "nsec"],
      "properties": {
        "sec": { "type": "integer", "minimum": 0 },
        "nsec": { "type": "integer", "minimum": 0, "maximum": 999999999 }
      }
    },
    "frame_id": { "type": "string" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "distortion_model": {
      "type": "string",
      "enum": ["plumb_bob", "rational_polynomial", "kannala_brandt", "equidistant", "none"]
    },
    "D": { "type": "array", "items": { "type": "number" } },
    "K": { "type": "array", "items": { "type": "number" }, "minItems": 9, "maxItems": 9 },
    "R": { "type": "array", "items": { "type": "number" }, "minItems": 9, "maxItems": 9 },
    "P": { "type": "array", "items": { "type": "number" }, "minItems": 12, "maxItems": 12 }
  }
}
