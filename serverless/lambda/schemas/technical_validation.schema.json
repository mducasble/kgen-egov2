{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TechnicalValidation",
  "description": "Machine-readable technical quality report. Mirrors TechnicalValidation.swift.",
  "type": "object",
  "properties": {
    "sessionId":     { "type": "string" },
    "timing":        { "type": "object" },
    "imu":           { "type": "object" },
    "video":         { "type": "object" },
    "videoEncoding": { "type": "object" },
    "calibration":   { "type": "object" },
    "passCriteria":  { "type": "object" }
  },
  "required": ["sessionId"],
  "additionalProperties": true
}
