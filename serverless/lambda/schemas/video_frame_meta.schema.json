{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VideoFrameMeta",
  "description": "Per-frame video timestamp and presentation metadata.",
  "type": "object",
  "properties": {
    "frameIndex":         { "type": "integer" },
    "timestampEpochMs":   { "type": "number" },
    "relativeMs":         { "type": "number" },
    "timestampNs":        { "type": "integer", "description": "Monotonic ns (mach_absolute_time)." },
    "clock":              { "type": "string" },
    "presentationTimeSec":{ "type": "number" },
    "isEstimated":        { "type": "boolean" }
  },
  "required": ["frameIndex", "timestampEpochMs", "timestampNs", "presentationTimeSec"],
  "additionalProperties": true
}
