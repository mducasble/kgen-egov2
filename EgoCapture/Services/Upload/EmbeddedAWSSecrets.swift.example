import Foundation

/// Copy this file to `EmbeddedAWSSecrets.swift` (same directory) and fill in
/// the real IAM credentials. The real file is gitignored and must never be
/// committed — GitHub secret scanning will block the push and AWS will disable
/// the keys automatically.
enum EmbeddedAWSSecrets {
    static let accessKeyId = "REPLACE_ME_ACCESS_KEY_ID"
    static let secretAccessKey = "REPLACE_ME_SECRET_ACCESS_KEY"
}
