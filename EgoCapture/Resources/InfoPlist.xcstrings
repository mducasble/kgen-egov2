    "NSCameraUsageDescription" : {
      "comment" : "System alert when the app first requests camera access.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EgoCapture needs camera access to record egocentric video for AI training data collection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EgoCapture necesita acceso a la cámara para grabar vídeo egocéntrico destinado a la recolección de datos de entrenamiento de IA."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O EgoCapture precisa de acesso à câmera para gravar vídeos egocêntricos para coleta de dados de treinamento de IA."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "System alert when the app first requests microphone access.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EgoCapture may use the microphone for synchronized audio capture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EgoCapture puede usar el micrófono para la captura de audio sincronizado."
          }
