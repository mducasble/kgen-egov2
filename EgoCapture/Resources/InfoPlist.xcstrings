    "NSMotionUsageDescription" : {
      "comment" : "System alert when the app first requests motion sensor access.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EgoCapture needs motion sensor access to record IMU data (accelerometer and gyroscope) synchronized with video."
