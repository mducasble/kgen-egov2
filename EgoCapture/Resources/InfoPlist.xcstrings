          "stringUnit" : {
            "state" : "translated",
            "value" : "EgoCapture necesita acceso a los sensores de movimiento para grabar datos IMU (acelerómetro y giroscopio) sincronizados con el vídeo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O EgoCapture precisa de acesso aos sensores de movimento para gravar dados IMU (acelerômetro e giroscópio) sincronizados com o vídeo."
